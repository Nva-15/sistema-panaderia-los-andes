# Copia este archivo como .env y completa tus datos (el .env NO se sube a GitHub)

# --- Base de datos local ---
DB_URL=jdbc:mysql://localhost:3306/panaderia_los_andes?createDatabaseIfNotExist=true&serverTimezone=America/Lima
DB_USERNAME=root
DB_PASSWORD=tu_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# --- Base de datos en la nube (Aiven / TiDB): exigen SSL ---
# DB_URL=jdbc:mysql://HOST:PUERTO/defaultdb?sslMode=REQUIRED&serverTimezone=America/Lima

# --- Administrador inicial (solo se crea si no hay usuarios) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Cambiar123!

# --- Asistente de IA (opcional): https://console.anthropic.com ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
