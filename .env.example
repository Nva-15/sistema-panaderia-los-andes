# Copia este archivo como .env y completa tus datos (el .env NO se sube a GitHub)

# --- Base de datos local ---
DB_URL=jdbc:mysql://localhost:3306/panaderia_los_andes?createDatabaseIfNotExist=true&serverTimezone=America/Lima
DB_USERNAME=root
DB_PASSWORD=tu_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# --- Base de datos en la nube (Aiven / TiDB): exigen SSL ---
# DB_URL=jdbc:mysql://HOST:PUERTO/defaultdb?sslMode=REQUIRED&serverTimezone=America/Lima

# --- Administrador inicial (solo se crea si no hay usuarios) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Cambiar123!

# --- Asistente de IA (opcional, gratuito) ---
# Groq (preferido): crear la key en https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Alternativa: Google Gemini, crear la key en https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- Automatizaciones con Make + Telegram (opcional) ---
# URL del webhook del escenario de Make; vacio = las automatizaciones se registran como SIN_WEBHOOK
AUTOMATIZACION_WEBHOOK_URL=
# Clave inventada por ti (cualquier texto); solo la usa GitHub Actions para las tareas programadas
AUTOMATIZACION_API_KEY=

# --- IoT (opcional): por defecto escucha el broker publico broker.hivemq.com ---
# MQTT_SERVIDOR=tcp://broker.hivemq.com:1883
# MQTT_TOPICO_BASE=losandes/utpgrupo03
